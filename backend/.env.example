# Personal Access Token issued by an IOsense admin for service/automation use.
# Same Authorization: Bearer <token> pattern as the browser JWT, but PATs don't expire.
# Get one from an org admin on the IOsense portal, then copy this file to .env and fill it in.
# NEVER put a real token in THIS file (.env.example) — it's committed to git. Real secrets go
# in .env, which is gitignored.
IOSENSE_PAT=

# Organisation ID the PAT should act on behalf of. The browser JWT flow works fine without this
# (confirmed live — see frontend/iosense.md), but a PAT isn't bound to one org via an SSO
# exchange the way a JWT is, so send it explicitly for service auth.
IOSENSE_ORG_ID=

# Optional: override the connector API base (defaults to https://connector.iosense.io/api)
# IOSENSE_API_BASE=https://connector.iosense.io/api

# Directory generated reports are written to (defaults to ./output)
# REPORT_OUTPUT_DIR=./output

# --- Scheduling (scheduler daemon only — `npm start`, not the one-shot `npm run generate`) ---
# The report is generated a few minutes BEFORE it's due, then EMAILED exactly at the scheduled
# time itself — e.g. scheduled for 10:10 with a 2-minute lead time means generation starts at
# 10:08, and the email goes out at 10:10 (not earlier, even if generation finishes sooner).
# REPORT_LEAD_TIME_MINUTES=15
#
# All times below are IST (Asia/Kolkata) wall-clock, regardless of what timezone the server
# itself runs in (most VMs default to UTC). Override with REPORT_TIMEZONE (IANA name, e.g.
# Asia/Kolkata) if you ever need a different zone.
# REPORT_TIMEZONE=Asia/Kolkata
#
# Management Report is weekly, so it needs a day-of-week — standard 5-field cron expression
# (minute hour day-of-month month day-of-week). Example: "0 6 * * 1" = Monday 6:00 AM.
MANAGEMENT_REPORT_CRON=0 6 * * 1

# Daily Report has no day-of-week, so just give it a plain 24-hour HH:MM time — no cron syntax
# needed. Example: DAILY_REPORT_TIME=06:00 means every day at 6:00 AM.
DAILY_REPORT_TIME=

# Advanced: if you'd rather express the daily schedule as a raw cron expression instead (e.g. to
# skip weekends), set DAILY_REPORT_CRON and leave DAILY_REPORT_TIME blank — DAILY_REPORT_TIME
# takes priority when both are set.
# DAILY_REPORT_CRON=0 6 * * *

# Monthly Report (same 5-sheet template as the Management Report, just windowed to the last
# fully-completed calendar month instead of a week) — give it a day-of-month + a plain 24-hour
# HH:MM time, no cron syntax needed. MONTHLY_REPORT_DATE must be 1-28 (capped so it exists in
# every month, including February). Example: MONTHLY_REPORT_DATE=1, MONTHLY_REPORT_TIME=06:00
# means the 1st of every month at 6:00 AM.
MONTHLY_REPORT_DATE=
MONTHLY_REPORT_TIME=

# Advanced: if you'd rather express the monthly schedule as a raw cron expression instead (e.g.
# "last day of the month", which a plain day-of-month can't express), set MONTHLY_REPORT_CRON and
# leave MONTHLY_REPORT_DATE/MONTHLY_REPORT_TIME blank — those take priority when both are set.
# MONTHLY_REPORT_CRON=0 6 1 * *

# Comma-separated recipient lists, one per report. Example:
#   MANAGEMENT_REPORT_RECIPIENTS=ops-lead@example.com,plant-manager@example.com
MANAGEMENT_REPORT_RECIPIENTS=
DAILY_REPORT_RECIPIENTS=
MONTHLY_REPORT_RECIPIENTS=

# --- Email delivery ---
# IOsense's own sendEmail API is used (not generic SMTP) — it fetches attachments by URL
# (a GET request FROM IOsense's servers TO this service), it doesn't accept uploaded bytes.
# That means REPORT_BASE_URL must be a PUBLICLY REACHABLE address — IOsense's servers need to
# be able to reach it. A report generated with this pointed at localhost will "send" (the email
# API call succeeds) but arrive with broken/missing attachments, because IOsense can never fetch
# them. Point this at wherever this service is actually deployed.
REPORT_BASE_URL=

# Port the file server listens on locally (defaults to 3000) — REPORT_BASE_URL should route to
# this port (directly, or via whatever reverse proxy/load balancer sits in front of it).
# FILE_SERVER_PORT=3000
